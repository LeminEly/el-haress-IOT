# Configuration d'editeur partagee — coherence de style avant tout outil
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Python (PEP 8)
[*.py]
indent_size = 4
max_line_length = 100

# Frontend / config web
[*.{ts,tsx,js,jsx,json,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[Makefile]
indent_style = tab
