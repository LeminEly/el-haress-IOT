[Unit]
Description=El-Haress backend API (FastAPI / Gunicorn)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=exec
User=el-haress
Group=el-haress
WorkingDirectory=/opt/el-haress/app/backend
EnvironmentFile=/etc/el-haress/el-haress.env
ExecStart=/opt/el-haress/app/backend/.venv/bin/gunicorn src.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

# Durcissement
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/el-haress

[Install]
WantedBy=multi-user.target
