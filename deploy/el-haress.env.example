# El-Haress — environnement de PRODUCTION (modele).
# Copier en /etc/el-haress/el-haress.env (proprietaire root:el-haress, chmod 640).
# Ne contient que des exemples : renseigner les vraies valeurs, ne jamais committer.

ENVIRONMENT=production
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Base de donnees (TimescaleDB locale sur le Pi)
DATABASE_URL=postgresql+asyncpg://el_haress:CHANGER@localhost:5432/el_haress
READINGS_RETENTION_DAYS=30

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_RATELIMIT=1
REDIS_DB_ALERT_DEDUP=2
REDIS_DB_JWT_BLACKLIST=3

# Authentification (cles RS256 hors depot)
JWT_PRIVATE_KEY_PATH=/etc/el-haress/keys/private.pem
JWT_PUBLIC_KEY_PATH=/etc/el-haress/keys/public.pem
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
JWT_ISSUER=el-haress
DEFAULT_PHONE_REGION=MR
REFRESH_COOKIE_NAME=el_haress_refresh
COOKIE_SECURE=true

# CORS : domaine public servi par Cloudflare Tunnel (jamais "*")
CORS_ORIGINS=https://supervision.exemple.com

# Collector / passerelle STE2 LITE (IP statique sur le segment capteurs)
STE2_BASE_URL=http://192.168.1.105
COLLECTOR_POLL_INTERVAL_SECONDS=10

# Notifications (secrets reels uniquement ici)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@exemple.com

SENTRY_DSN=
