# ============================================================================
# El-Haress — variables d'environnement (modele)
# Copier en .env et renseigner. NE JAMAIS committer le .env reel.
# Toutes les valeurs ci-dessous sont des exemples non sensibles.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Base de donnees — TimescaleDB (PostgreSQL 16 + extension)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://el_haress:dev_password@localhost:5432/el_haress
POSTGRES_USER=el_haress
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=el_haress
POSTGRES_PORT=5432
READINGS_RETENTION_DAYS=30        # retention native TimescaleDB (regle absolue)

# ----------------------------------------------------------------------------
# Redis — bases logiques separees (cache / rate limit / dedup / blacklist)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_RATELIMIT=1
REDIS_DB_ALERT_DEDUP=2
REDIS_DB_JWT_BLACKLIST=3

# ----------------------------------------------------------------------------
# Authentification — JWT RS256 (cles hors depot, dans keys/)
# ----------------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
JWT_ISSUER=el-haress
DEFAULT_PHONE_REGION=MR             # region par defaut pour normaliser les numeros
REFRESH_COOKIE_NAME=el_haress_refresh
COOKIE_SECURE=false                 # METTRE true en production (cookies via HTTPS uniquement)

# ----------------------------------------------------------------------------
# CORS — whitelist explicite, jamais "*" en production
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------------
# Collector — polling des capteurs (intervalle configurable, jamais en dur)
# ----------------------------------------------------------------------------
STE2_BASE_URL=http://192.168.1.50
COLLECTOR_POLL_INTERVAL_SECONDS=0.5   # cadence de polling, sous-seconde autorisee (0.5 = 500 ms)
SENSOR_OFFLINE_AFTER_SECONDS=5        # au-dela, capteur juge hors-ligne (masque du dashboard, garde dans l'historique)

# ----------------------------------------------------------------------------
# Notifications — Twilio (WhatsApp + SMS) et SMTP (Email)
# Numeros au format international, sans le prefixe "whatsapp:" (ajoute par le code).
# Sandbox WhatsApp Twilio : TWILIO_WHATSAPP_FROM=+14155238886 (le destinataire
# doit d'abord rejoindre le sandbox). En production : sender WhatsApp approuve.
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@el-haress.local

# ----------------------------------------------------------------------------
# Observabilite (optionnel)
# ----------------------------------------------------------------------------
SENTRY_DSN=
